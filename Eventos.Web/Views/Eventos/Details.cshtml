@model Eventos.Web.Models.Evento
@{ ViewData["Title"] = "Detalle del evento"; var count = Model.Inscripciones.Count(i => i.Estado == "Confirmada"); }
<div class="page-heading"><div><div class="eyebrow">EVENTOS / DETALLE</div><h1>@Model.Titulo</h1><p>@Model.Categoria?.Nombre · @Model.Modalidad</p></div><a class="button" asp-action="Edit" asp-route-id="@Model.Id">Editar evento</a></div><section class="panel form-panel"><div class="details"><div><span>FECHA</span><strong>@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</strong></div><div><span>LUGAR</span><strong>@Model.Lugar</strong></div><div><span>PRECIO</span><strong>@Model.Precio.ToString("N2")</strong></div><div><span>CONFIRMADOS / AFORO</span><strong>@count / @Model.Aforo</strong></div><div><span>CUPOS DISPONIBLES</span><strong>@Math.Max(0,Model.Aforo-count)</strong></div></div><div class="form-actions"><a class="button-light" asp-action="Index">Volver</a></div></section>
