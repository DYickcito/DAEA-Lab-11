@model Eventos.Web.Models.Evento
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="form-grid">
<div class="field full"><label asp-for="Titulo">Título</label><input asp-for="Titulo" /><span asp-validation-for="Titulo" class="text-danger"></span></div>
<div class="field"><label asp-for="Fecha"></label><input asp-for="Fecha" type="datetime-local" /><span asp-validation-for="Fecha" class="text-danger"></span></div>
<div class="field"><label asp-for="Lugar"></label><input asp-for="Lugar" /><span asp-validation-for="Lugar" class="text-danger"></span></div>
<div class="field"><label asp-for="CategoriaId">Categoría</label><select asp-for="CategoriaId" asp-items="ViewBag.Categorias"><option value="">Selecciona una categoría</option></select><span asp-validation-for="CategoriaId" class="text-danger"></span></div>
<div class="field"><label asp-for="Modalidad"></label><select asp-for="Modalidad"><option value="Presencial">Presencial</option><option value="Virtual">Virtual</option></select><span asp-validation-for="Modalidad" class="text-danger"></span></div>
<div class="field"><label asp-for="Aforo"></label><input asp-for="Aforo" /><span asp-validation-for="Aforo" class="text-danger"></span></div>
<div class="field"><label asp-for="Precio"></label><input asp-for="Precio" type="number" step="0.01" /><span asp-validation-for="Precio" class="text-danger"></span></div></div>
<div class="form-actions"><button class="button" type="submit">Guardar evento</button><a class="button-light" asp-action="Index">Volver</a></div>
