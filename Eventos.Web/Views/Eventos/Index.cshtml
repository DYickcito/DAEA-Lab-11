@model IEnumerable<Eventos.Web.Models.Evento>
@{ ViewData["Title"] = "Eventos"; }
<div class="page-heading"><div><div class="eyebrow">GESTIÓN DE EVENTOS / 01</div><h1>Eventos</h1><p>Organiza encuentros que dejan huella.</p></div><a class="button" asp-action="Create">+ Nuevo evento</a></div>
<section class="panel"><div class="panel-head"><div><h2>Próximos y activos</h2><p>Consulta la disponibilidad y administra tus eventos.</p></div><form method="get" class="filter"><label for="categoriaId">Categoría</label><select id="categoriaId" name="categoriaId" asp-items="ViewBag.Categorias" onchange="this.form.submit()"><option value="">Todas las categorías</option></select><button class="button-light" type="submit">Filtrar</button></form></div>
<div class="table-wrap"><table><thead><tr><th>EVENTO</th><th>FECHA Y LUGAR</th><th>MODALIDAD</th><th>INSCRITOS / CUPOS</th><th></th></tr></thead><tbody>
@foreach (var e in Model) { var count = e.Inscripciones.Count(i => i.Estado == "Confirmada"); <tr><td><strong>@e.Titulo</strong><span class="sub">@e.Categoria?.Nombre</span></td><td>@e.Fecha.ToString("dd MMM yyyy · HH:mm")<span class="sub">@e.Lugar</span></td><td><span class="badge-soft">@e.Modalidad</span></td><td><strong>@count / @e.Aforo</strong><span class="sub">@(Math.Max(0,e.Aforo-count)) disponibles</span></td><td class="actions"><a asp-action="Details" asp-route-id="@e.Id">Ver</a><a asp-action="Edit" asp-route-id="@e.Id">Editar</a><a asp-action="Delete" asp-route-id="@e.Id">Desactivar</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="5" class="empty">No hay eventos para mostrar.</td></tr> }</tbody></table></div></section>
