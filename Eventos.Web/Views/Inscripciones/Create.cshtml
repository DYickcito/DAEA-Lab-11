@model Eventos.Web.Models.Inscripcion
@{ ViewData["Title"] = "Nueva inscripción"; }
<div class="page-heading"><div><div class="eyebrow">INSCRIPCIONES / NUEVA</div><h1>Nueva inscripción</h1><p>Selecciona un evento y un asistente para confirmar su participación.</p></div></div><section class="panel form-panel"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="form-grid"><div class="field full"><label asp-for="EventoId">Evento</label><select asp-for="EventoId" asp-items="ViewBag.Eventos"><option value="">Selecciona un evento</option></select><span asp-validation-for="EventoId" class="text-danger"></span></div><div class="field full"><label asp-for="AsistenteId">Asistente</label><select asp-for="AsistenteId" asp-items="ViewBag.Asistentes"><option value="">Selecciona un asistente</option></select><span asp-validation-for="AsistenteId" class="text-danger"></span></div></div><div class="form-actions"><button class="button">Confirmar inscripción</button><a class="button-light" asp-action="Index">Volver</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
