@model IEnumerable<Eventos.Web.Models.Inscripcion>
@{ ViewData["Title"] = "Inscripciones"; }
<div class="page-heading"><div><div class="eyebrow">REGISTROS / 03</div><h1>Inscripciones</h1><p>Un espacio para cada nueva conexión.</p></div><a class="button" asp-action="Create">+ Nueva inscripción</a></div><section class="panel"><div class="panel-head"><div><h2>Historial de inscripciones</h2><p>Consulta las confirmaciones y cancelaciones.</p></div></div><div class="table-wrap"><table><thead><tr><th>EVENTO</th><th>ASISTENTE</th><th>FECHA DE INSCRIPCIÓN</th><th>ESTADO</th><th></th></tr></thead><tbody>@foreach(var i in Model) { <tr><td><strong>@i.Evento?.Titulo</strong></td><td>@i.Asistente?.Nombres</td><td>@i.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td><td><span class="badge-soft">@i.Estado</span></td><td class="actions">@if(i.Estado == "Confirmada") { <form asp-action="Cancelar" asp-route-id="@i.Id" method="post"><button class="link-button" type="submit" onclick="return confirm('¿Cancelar esta inscripción?')">Cancelar</button></form> }</td></tr> } @if (!Model.Any()) { <tr><td colspan="5" class="empty">Todavía no hay inscripciones.</td></tr> }</tbody></table></div></section>
