<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · Eventos</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body>
<header class="topbar"><div class="shell nav-wrap"><a class="brand" asp-controller="Eventos" asp-action="Index"><span class="brand-mark">E</span><span>EVENTOS<small>GESTIÓN & ENCUENTROS</small></span></a><nav><a asp-controller="Eventos" asp-action="Index">Eventos</a><a asp-controller="Asistentes" asp-action="Index">Asistentes</a><a asp-controller="Inscripciones" asp-action="Index">Inscripciones</a></nav></div></header>
<main class="shell main-content">@if (TempData["Mensaje"] != null) { <div class="notice" role="status">@TempData["Mensaje"]</div> } @RenderBody()</main>
<footer class="shell footer"><span>EVENTOS / GESTIÓN</span><span>Conectando personas e ideas.</span></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>
