@model IEnumerable<Eventos.Web.Models.Asistente>
@{ ViewData["Title"] = "Asistentes"; }
<div class="page-heading"><div><div class="eyebrow">DIRECTORIO / 02</div><h1>Asistentes</h1><p>Las personas detrás de cada encuentro.</p></div><a class="button" asp-action="Create">+ Nuevo asistente</a></div><section class="panel"><div class="panel-head"><div><h2>Directorio de asistentes</h2><p>Personas activas registradas en la plataforma.</p></div></div><div class="table-wrap"><table><thead><tr><th>NOMBRES</th><th>DNI</th><th>CORREO</th><th>TELÉFONO</th></tr></thead><tbody>@foreach(var a in Model) { <tr><td><strong>@a.Nombres</strong></td><td>@a.Dni</td><td>@a.Correo</td><td>@(a.Telefono ?? "—")</td></tr> } @if (!Model.Any()) { <tr><td colspan="4" class="empty">No hay asistentes registrados.</td></tr> }</tbody></table></div></section>
